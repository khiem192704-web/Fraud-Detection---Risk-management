{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "1. Chay Giao Dien Do Hoa (Qt6 GUI)",
            "command": "cmd.exe",
            "args": [
                "/c",
                "start",
                "",
                "..\\EPFD-RAS-Final\\build_gui\\epfd_gui.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ]
