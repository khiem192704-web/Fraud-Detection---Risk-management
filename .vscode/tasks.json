{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "1. Chạy Giao Diện Đồ Họa (Qt6 GUI)",
            "command": "cmd.exe",
            "args": [
                "/c",
                "start",
                "",
                "${workspaceFolder}\\build_gui\\epfd_gui.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "2. Biên Dịch & Chạy GUI (Build & Run GUI)",
            "command": "cmd.exe",
            "args": [
                "/c",
                "cmake --build build_gui && start \"\" \"${workspaceFolder}\\build_gui\\epfd_gui.exe\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "3. Chạy Bản Console (Terminal ANSI)",
            "command": "cmd.exe",
            "args": [
                "/c",
                "start",
                "EPFD Console",
                "${workspaceFolder}\\build_gui\\epfd_app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
